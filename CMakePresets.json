{
  "version": 3,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug build with optimization disabled",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Release build with optimization enabled",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Debug Build",
      "description": "Build debug target",
      "configurePreset": "debug"
    },
    {
      "name": "debug-clean",
      "displayName": "Debug Clean & Build",
      "description": "Clean and build debug target",
      "configurePreset": "debug",
      "cleanFirst": true
    },
    {
      "name": "release",
      "displayName": "Release Build",
      "description": "Build release target",
      "configurePreset": "release"
    },
    {
      "name": "release-clean",
      "displayName": "Release Clean & Build",
      "description": "Clean and build release target",
      "configurePreset": "release",
      "cleanFirst": true
    }
  ]
}
